{
  "name": "agent-skill-gate-vscode",
  "displayName": "Agent Skill Gate",
  "publisher": "fcemtopall",
  "description": "Status bar integration and fast capability switcher for Agent Skill Gate",
  "version": "1.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fcemtopall/agent-skill-gate"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/.agent-skills.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentSkillGate.toggleSkills",
        "title": "Agent Skills: Skilleri Yönet",
        "category": "Agent Skill Gate"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.0"
  }
}
